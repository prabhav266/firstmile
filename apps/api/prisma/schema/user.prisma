model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  year          Int?
  branch        String?
  college       String?
  targetCompany String?
  leetcodeUsername String? @unique
  githubUsername   String? @unique
  role          Role      @default(STUDENT)
  refreshToken  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  skills        UserSkill[]
  projects      Project[]
  roadmaps      Roadmap[]
  codingLogs    CodingLog[]
  mlLogs        MLLog[]
  resumes       Resume[]
  recommendations Recommendation[]
  plannerWeeks  PlannerWeek[]
  interviews    InterviewSession[]
  goals         Goal[]
  notifications Notification[]
  analytics     Analytics[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

enum Role {
  STUDENT
  ADMIN
}
