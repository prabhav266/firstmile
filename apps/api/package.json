{
  "name": "@pathforge/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema=prisma/schema",
    "db:migrate": "prisma migrate dev --schema=prisma/schema",
    "db:push": "prisma db push --schema=prisma/schema",
    "db:studio": "prisma studio --schema=prisma/schema",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "express": "^4.21.2",
    "@prisma/client": "^6.8.2",
    "jose": "^5.10.0",
    "bcryptjs": "^3.0.2",
    "zod": "^3.25.67",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "express-rate-limit": "^7.5.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "axios": "^1.9.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "prisma": "^6.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
