# Database Configuration
POSTGRES_USER=pathforge
POSTGRES_PASSWORD=pathforge_secret
POSTGRES_DB=pathforge_db
DATABASE_URL=postgresql://pathforge:pathforge_secret@postgres:5432/pathforge_db?schema=public

# Authentication Secrets
JWT_SECRET=pathforge-super-secret-access-token-key-32-chars-long
JWT_REFRESH_SECRET=pathforge-super-secret-refresh-token-key-32-chars-long

# Services URLs
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://ml:8000
PORT=4000
NODE_ENV=development

# Gemini API Key (For FastAPI AI backend)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
