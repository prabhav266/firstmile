{
  "name": "pathforge-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:api": "prisma generate --schema=apps/api/prisma/schema && pnpm --filter @pathforge/api build",
    "start:api": "node apps/api/dist/server.js",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@pathforge/web",
    "dev:api": "turbo dev --filter=@pathforge/api",
    "dev:ml": "cd apps/ml && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "docker:dev": "docker-compose -f docker-compose.yml up --build",
    "docker:down": "docker-compose down",
    "db:migrate": "turbo db:migrate --filter=@pathforge/api",
    "db:studio": "turbo db:studio --filter=@pathforge/api",
    "db:push": "turbo db:push --filter=@pathforge/api",
    "db:seed": "turbo db:seed --filter=@pathforge/api"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "prisma": "^6.8.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
